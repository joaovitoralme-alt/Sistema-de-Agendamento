# Copie para um arquivo chamado .env (no servidor) e preencha.
# NUNCA envie o .env para o GitHub.

# Domínio do site, sem https:// (ex.: elosdesatisfacao.com.br)
DOMINIO=seudominio.com.br

# Senha do banco de dados (invente uma longa; ninguém precisa decorar)
DB_SENHA=troque-por-uma-senha-longa

# Segredo que assina os tokens de login (JWT). Mínimo 32 caracteres, aleatório.
# Para gerar um no Linux:  openssl rand -base64 48
JWT_CHAVE=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Primeiro usuário do painel (entra com o e-mail; o identificador @a000000@ aparece em "Minha conta").
# Depois de entrar, troque a senha em "Minha conta".
ADMIN_NOME=Seu Nome
ADMIN_EMAIL=voce@email.com
ADMIN_SENHA=troque-esta-senha
